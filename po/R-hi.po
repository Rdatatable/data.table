msgstr "'names' TRUE/FALSE या कैरेक्टर (character) वेक्टर (vector) होना चाहिए।"

#: transpose.R:34
#, c-format
msgid "'keep' should contain integer values between %d and %d."
msgstr "'keep' में %d से %d के बीच पूर्णांक (integer) मान होने चाहिए।"

